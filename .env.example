# =============================================================================
# Water Consumption Prediction — Environment Configuration
# Copy this file to `.env` and replace placeholder values.
# NEVER commit real secrets to version control.
# =============================================================================

# --- Application ---
NODE_ENV=development
APP_ENV=development
PORT=8000
BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
API_URL=http://127.0.0.1:8000

# --- Database (prefer DATABASE_URL; or set components below) ---
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME
DB_HOST=localhost
DB_PORT=5432
DB_NAME=WBP_DB
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- ML / Flask service ---
ML_SERVICE_URL=http://127.0.0.1:4050
ML_PREDICT_ALL_PATH=/predict-all
ML_REQUEST_TIMEOUT=10
FLASK_HOST=0.0.0.0
FLASK_PORT=4050
FLASK_DEBUG=false

# --- Auth / session ---
# App currently uses opaque session tokens (not JWT). Keep secrets set for production readiness.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
SESSION_MINUTES=45
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Admin seed script (Backend/seed_admin.py) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
ADMIN_USERNAME=admin
ADMIN_FULLNAME=Administrator
ADMIN_PHONE=

# --- Frontend (Next.js public vars — also set in Frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_SESSION_MINUTES=45

# --- Optional: Email / SMTP (not wired yet) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- Optional: Cloudinary (not wired yet) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional: AWS S3 (not wired yet) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

# --- Optional: Redis (not wired yet) ---
REDIS_URL=
